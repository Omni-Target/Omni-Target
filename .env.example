# ==============================================================================
# Omni Target — Environment Variables Template
# Copy this file to .env.local for local development, or configure in Vercel
# for Staging and Production deployments.
# ==============================================================================

# --- Application URL ---
# Must match your deployment origin (e.g. http://localhost:3000 locally,
# https://staging.omnitarget.co for staging, https://app.omnitarget.co for production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk Authentication ---
# Obtain from Clerk Dashboard: https://dashboard.clerk.com
# For staging, ensure your staging domain is added to Authorized Domains.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding/connect-shopify
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/connect-shopify

# --- Supabase Database & REST API ---
# Runtime application queries use PostgREST via HTTPS (no connection pool exhaustion).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Supabase Direct Postgres Connection (Migrations Runner) ---
# Required to execute: npm run migrate (node supabase/migrate.mjs up)
# IMPORTANT: Use the Session Pooler (port 5432) or Direct Connection.
# Do NOT use the Transaction Pooler (port 6543) as it does not support DDL transactions.
SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Shopify App Credentials ---
# From Shopify Partner Dashboard → Apps → Omni Target → App Setup
SHOPIFY_CLIENT_ID=0c6afe04bdb8...
SHOPIFY_CLIENT_SECRET=shpss_...
SHOPIFY_WEBHOOK_SECRET=shpss_...
# Set to "true" on staging to enable test/mock subscription billing charges:
SHOPIFY_TEST_BILLING=true

# --- Meta App Credentials ---
# From Meta Developer Portal → Apps → Omni Target → Settings / Facebook Login
META_APP_ID=2171346287001753
META_APP_SECRET=0c42dd37...
# Optional: routes events to Meta Events Manager Test Events tab
# META_CAPI_TEST_CODE=TEST12345

# --- AI Engine (Anthropic Claude) ---
# Primary engine powering campaign briefs, copy generation, and targeting profiles.
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- Headless Chromium for PDF Generation (Vercel Serverless) ---
# Required on Vercel for @sparticuz/chromium-min v131.0.1.
# Points to hosted brotli binary pack to keep serverless function bundle under 50 MB.
# For maximum speed and reliability, re-host this tar on Cloudflare R2 or Vercel Blob.
CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v131.0.1/chromium-v131.0.1-pack.tar

# --- Vercel Cron Secret ---
# Protects /api/cron/brief-nudge and /api/cron/sync-stores from unauthorized calls.
CRON_SECRET=your_cron_secret_here

# --- Cloudflare R2 Asset Storage ---
# For uploaded merchant ad creatives and product assets.
CLOUDFLARE_ACCOUNT_ID=2faf4340165de46f093e339d1933d04c
R2_ACCESS_KEY_ID=175c7cb2418cdac5909a00618db659bd
R2_SECRET_ACCESS_KEY=0af60c5dd322bced909324dc3c41d7ed9caec68223e73c40d41086660628aa0f
R2_BUCKET_NAME=omni-target-assets
# Must point to a verified custom domain in production:
R2_PUBLIC_URL=https://assets.omnitarget.co

# --- Transactional Email (Resend) ---
RESEND_API_KEY=re_...

# --- Optional Secondary Payment Providers ---
# Shopify Billing is the primary payment mechanism.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYSTACK_SECRET_KEY=sk_test_...
